# Build output
build/

# Logs
*.log
build_log.txt
cmake_debug*.log

# VS Code
.vscode/

# ESP-IDF generated
sdkconfig.old

# ESP-IDF managed components (auto-fetched from idf_component.yml + dependencies.lock)
managed_components/

# Local build scratch
_build_tmp.bat

# Claude Code transient state (worktrees, scratch, settings overrides)
.claude/worktrees/
.claude/launch.json
.claude/settings.local.json

# Python bytecode cache (tools/ scripts get run from here and leave
# __pycache__ behind; not worth committing)
__pycache__/
*.pyc
*.pyo

# Accidental Windows-path-as-directory — created when a shell misinterprets
# an unquoted Windows path like `C:\Users\ruuva\workspace\rdm7-sandbox` as
# a relative path, turning it into a literal directory named
# `Usersruuvaworkspacerdm7-sandbox`. Catch the whole pattern.
Usersruuvaworkspace*/

# Scratch/experiment artifacts under tools/ (the "_" prefix is the workspace
# scratch convention: throwaway layouts, screenshots, capture scripts,
# per-cluster WIP). Keep them local; don't clutter the tree.
tools/_*

# More local cluster-dev scratch that predates the tools/_* convention:
# per-car reference images, occluder/needle captures, one-off layout JSON and
# an SVG preview. Kept on disk, out of the product tree.
tools/altezza/
tools/apex.json
tools/aurora_layout.json
tools/ford_cluster_preview.svg
# stray reference photo dropped into the embedded-web dir (not referenced by
# index.html; must never be embedded into firmware)
main/web/ford_ref.jpg
