# FAT long filename support (for SD card)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=63

CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_PERF_MONITOR=y

# Multi-stop gradients for bar / rpm_bar widgets. Default is 2 (single
# start→end). 8 matches GRADIENT_MAX_STOPS in widgets/gradient_stops.h
# so the firmware can pass a full Photoshop-authored stops array
# straight into lv_obj_set_style_bg_grad without truncation.
CONFIG_LV_GRADIENT_MAX_STOPS=8

# Task watchdog — 15 s instead of the 5 s default. First-boot layout load
# with many widgets, custom TTF font instances, and 1+ MB image widgets
# can legitimately hold the LVGL task on CPU 1 for several seconds of
# cumulative work, even with yield points sprinkled through the hot paths
# (layout_manager, widget_image, font_manager). 15 s still catches real
# task hangs without false-tripping on heavy boot work.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# Reboot (not just warn) if a subscribed task stops petting the watchdog. Only
# the LVGL render task is subscribed (main.c) — a frozen render loop is a dead
# dash, so panic-reboot is the right recovery. The 15 s budget above keeps a
# heavy layout reload from tripping it.
CONFIG_ESP_TASK_WDT_PANIC=y

# OTA rollback safety. There is no factory partition, so every boot runs from
# an OTA slot in PENDING_VERIFY; the firmware calls
# esp_ota_mark_app_valid_cancel_rollback() after ~10 s of healthy rendering
# (main.c). An image that boot-loops before then is rolled back to the previous
# slot by the bootloader instead of bricking the dash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# WiFi — reduce static RX buffers (10×1600B=16KB DMA RAM) to 6 so
# esp_wifi_init succeeds on first boot when the first-run wizard holds
# extra internal heap. SPIRAM_TRY_ALLOCATE_WIFI_LWIP covers higher layers.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# WiFi — static TX buffers are DMA-capable INTERNAL RAM (~1.6 KB each), so
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP cannot move them: 16 of them pin ~25 KB of the
# 72 KB of DIRAM the link leaves free. That is what starved OTA.
#
# Measured 2026-08-16 across four dashes, internal_largest_free vs the 6144 B
# contiguous stack an OTA task needs:
#
#     RDM-1CDB-D444  5632      RDM-DCB4-D936  5120
#     RDM-DCB4-D926  5376      RDM-E806-90A2  2304   (43 min uptime)
#
# Every one short, including 29 s after a cold boot, so xTaskCreate failed and
# the update died before opening a socket — reported as a flaky network for
# months. Confirmed NOT a leak: 90A2 held 2651/2304/2459 dead flat over 3 min.
# The spread is per-device configuration (layout, signal count), not uptime.
#
# 8 still covers a 3 MB OTA, which is RX-heavy; TX depth only bounds how many
# frames can be in flight upstream, and the dash's uplink is HTTP requests and
# the CONTROL preview. Revisit if throughput regresses under the web editor.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# TLS — SOFTWARE AES, deliberately, because the hardware engine cannot reach
# the buffers we give it. MBEDTLS_EXTERNAL_MEM_ALLOC puts TLS buffers in PSRAM
# (the only way they fit), but the S3's AES DMA engine can't read PSRAM, so
# esp_aes falls back to bounce-buffering each record through a heap_caps_malloc
# of DMA-capable INTERNAL RAM sized to MBEDTLS_SSL_IN_CONTENT_LEN (16 KB).
# This board runs with ~7 KB of internal RAM free, so that allocation fails and
# the handshake dies immediately after the certificate validates:
#
#     esp-x509-crt-bundle: Certificate validated
#     esp-aes: Failed to allocate memory
#     esp-tls-mbedtls: read error :-0x0001:
#
# Measured 2026-08-15: the update check failed 0/6 on one build and 1/7 on
# another while an older image passed 4/4 — the odds simply track whatever
# internal RAM happens to be free, which is why it read as a flaky network.
# It is the same starvation behind the old "OTA download dies at 1%" bug,
# where a second concurrent TLS context was the thing that didn't fit.
#
# Software AES needs no DMA buffer and works on PSRAM directly. The cost is
# throughput on a 3 MB download that already takes minutes over WiFi, against
# an update path that otherwise needs a USB cable to recover. Revisit only if
# internal RAM headroom grows by tens of KB.
CONFIG_MBEDTLS_HARDWARE_AES=n

# FPS: bounce buffer was TRIED 2026-06-09 and ABANDONED — it crashed on-device
# (abort() on core 1 mid-render with single-FB+bounce) AND the flush instrumentation
# showed NO improvement (~7.7 ms/frame at 21% dirty, same as the DOUBLE_FB baseline:
# the dirty-rect memcpy into PSRAM dominates, the skipped full-FB msync nets ~zero).
# Keep DOUBLE_FB (the known-good 120-line PSRAM draw-buffer render path is unchanged).

# FPS: confine the lwIP TCP/IP task (prio 18) to core 0 alongside WiFi/CAN-RX/
# esp_timer so it can't preempt the prio-8 LVGL renderer on core 1 mid-frame.
# Helps specifically while the web editor / CONTROL live-preview is polling.
# CONFIG_LWIP_TCPIP_TASK_AFFINITY_NO_AFFINITY is not set
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# LittleFS
CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_BLOCK_CYCLES=512

# The USB Serial/JTAG PHY owns GPIO19/20, which on this board are CAN RX/TX.
# Leaving the secondary console enabled lets the PHY re-claim the CAN pins
# and hold the transmit line floating (= bus dominant = jammed bus). The
# primary console is UART0 via the CH343, so nothing is lost by turning it
# off. See bootloader_components/rdm_can_park.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# The bootloader self-update (main/storage/bootloader_selfupdate.c) writes the
# bootloader region at 0x0, and IDF's default DANGEROUS_WRITE_ABORTS turns that
# into abort() — the dash panics and reboots instead of updating.
#
# This removes that net globally, so it is worth being precise about what it
# was protecting: bootloader_selfupdate.c is the ONLY code in this firmware
# that calls esp_flash_write/esp_flash_erase directly. OTA, LittleFS and NVS
# all go through esp_partition_*, which bounds-checks against the partition
# independently and is unaffected. The one raw writer carries its own explicit
# BL_OFFSET / BL_REGION_SIZE bounds and refuses anything that does not fit.
#
# If a second raw-flash writer is ever added, reconsider this.
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# ── Bluetooth Low Energy ────────────────────────────────────────────────────
# Enabled 2026-09 so the phone app can reach the dash without taking over the
# phone's network. BLE is a transport for the existing STX/CRC serial protocol
# (main/net/ble_protocol.c), not a second API.
#
# Peripheral only, one connection: the dash is never a central and never talks
# to two phones at once, and switching the unused roles off is most of what
# keeps NimBLE inside the ~400 KB of headroom left in the 3.5 MB OTA slot.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# A layout is tens of kilobytes. At the 23-byte default MTU that is thousands
# of notifications; asking for the maximum lets a phone that agrees move it in
# one second rather than fifteen.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8

# ── Internal-SRAM budget for running BLE and WiFi together ──────────────────
# The ESP32-S3 has 512 KB of internal SRAM no matter how much PSRAM is fitted,
# and it is the only memory the BT controller, the WiFi driver and DMA can use.
# Adding BLE cost ~35 KB of it and left WiFi unable to start — esp_wifi_init()
# returning ESP_ERR_NO_MEM inside an ESP_ERROR_CHECK, i.e. a boot loop. These
# settings are what make both radios fit. Measured on an 8 MB unit; internal
# SRAM is identical across PSRAM variants, so they carry over unchanged.
#
# Caches come out of that same 512 KB, and they were halved (I 32->16 KB,
# D 64->16 KB) to make BLE fit. That was a mistake worth recording: LVGL
# renders into PSRAM framebuffers THROUGH the data cache, and all code runs
# from PSRAM (XIP), so a 16 KB cache meant slow rendering and far more PSRAM
# bus traffic from the radios — which is what the panel DMA competes with. The
# full caches are back; the RAM came from SPIRAM_MALLOC_ALWAYSINTERNAL=0 and
# the external .bss segment instead.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Keep internal SRAM for the things that can only live there. Generic malloc()
# goes to PSRAM FIRST, at every size: ALWAYSINTERNAL=0. The old value of 1024
# sent every allocation of 1 KB or less into internal SRAM ahead of the radios,
# and that is almost every allocation the firmware makes — LVGL uses malloc for
# its whole widget graph (main/lv_conf.h), httpd mallocs 155 URI entries, cJSON
# is nothing but small nodes. With BLE resident that drained internal SRAM to
# zero by the time SNTP started and lwIP's per-thread semaphore could not be
# created (NULL deref in sys_arch_sem_wait, every boot). Things that must be
# internal — FreeRTOS objects, WiFi/BT buffers, DMA — ask for it explicitly
# through heap_caps_malloc and are unaffected. RESERVE_INTERNAL holds this
# much back for them regardless.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# NimBLE's host pools go to PSRAM; only the controller truly needs internal.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# The dash is a peripheral holding one phone. It never scans and never acts as
# a central, so the controller does not need state for six simultaneous
# activities or a 100-entry duplicate-advertisement cache.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=10
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=3072

# WiFi buffers: DO NOT trim the association path to buy internal RAM.
#
# Measured the hard way. Cutting MGMT_SBUF_NUM to 16 and STATIC_TX_BUFFER_NUM
# to 4 made the dash unable to join a strong AP with correct credentials — the
# driver logged "m f auth" and the link died with reason 2 (AUTH_EXPIRE) then
# reason 39 (TIMEOUT), four or five times a minute. Auth and assoc are
# management frames on a timed handshake; starve their buffers and association
# fails while everything else looks healthy. The values that work are the ones
# set earlier in this file (STATIC_RX 6, STATIC_TX 8, MGMT_SBUF 32) — this
# block deliberately no longer overrides them.
#
# Throughput-only buffers are still fair game, and CACHE_TX_BUFFER_NUM has a
# Kconfig range of 16-128: anything below 16 is silently replaced by the
# default of 32, which is how an earlier "saving" here turned out to be
# imaginary. Always confirm against build/config/sdkconfig.h, never sdkconfig.
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# Leave these ON. Moving WiFi's hot path out of IRAM buys ~15 KB but starves
# the BT controller's ISR during a scan, which trips the interrupt watchdog
# and panics the dash. Tried, measured, reverted.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# ── WiFi association path — authoritative, keep last ────────────────────────
# These are repeated at the end of the file on purpose: this project's build
# applies sdkconfig.defaults over sdkconfig, and later entries win, so an
# earlier block silently overrode these and cost hours of misdiagnosis. If a
# value here disagrees with build/config/sdkconfig.h, trust the header.
#
# Starving these breaks joining a known-good AP: the driver logs "m f auth"
# and the link fails with reason 2 (AUTH_EXPIRE) then reason 39 (TIMEOUT).
# TX buffer TYPE is deliberately left STATIC — see the measured rationale
# further up this file (16 buffers pinned ~25 KB and starved OTA across four
# dashes). Switching to dynamic looks tempting because those buffers could
# then live in PSRAM, but dynamic TX from PSRAM needs internal CACHE TX
# buffers to DMA from, and CACHE_TX_BUFFER_NUM has a Kconfig minimum of 16 at
# ~1.6 KB each — trading ~13 KB of pinned internal for ~26 KB. Not a win.
#
# With Bluetooth resident the driver does log "m f null" under load: it is out
# of TX buffers for the null-data frames it must send each time BT takes the
# antenna. That is a throughput symptom, not a fault — the link stays up. If
# it ever needs fixing, measure the cache-TX cost first.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=32

# Display: bounce-buffer mode. This is what stops the screen tearing/shifting
# whenever something else gets busy — WiFi traffic, a layout change, anything
# that hits the PSRAM bus.
#
# Why it happens without this: the RGB panel's DMA reads pixels straight out of
# the PSRAM framebuffer, in real time, and that same bus carries all code
# execution (XIP), the WiFi/lwIP buffers and LVGL's own rendering. A burst of
# traffic starves the DMA for a few hundred microseconds, the panel is clocked
# dummy bytes, and the image shifts until LCD_RGB_RESTART_IN_VSYNC snaps it
# back at the next frame. Bounce buffers (esp_lcd docs, "Bounce Buffer with
# Single PSRAM Frame Buffer") put two small internal-SRAM buffers between the
# two: DMA reads those, and an interrupt keeps them topped up from PSRAM, so a
# bus stall is absorbed instead of reaching the panel.
#
# Two things this mode needs, both non-obvious:
#   * The refill interrupt must stay on CORE 0. On core 1 it competes with
#     LVGL for the same core and full-screen renders went 82 ms -> 165 ms.
#     (main.c keeps the core-1 variant behind RDM_PANEL_ISR_ON_CORE1 = 0.)
#   * The full data cache. Measured with the caches halved it looked like
#     bounce mode itself was the problem; with D-cache back at 64 KB the same
#     config costs nothing measurable (81 ms first frame, 47 fps, vs 82/47
#     without bounce).
#
# XIP (SPIRAM_FETCH_INSTRUCTIONS + SPIRAM_RODATA above) is what keeps the cache
# alive through esp_flash writes and erases, so NVS saves and the OTA download
# do not stop the refill. That guarantee does NOT extend to memory MAPPING:
# esp_mmu_map() switches the cache off unconditionally to rewrite MMU entries,
# and esp_ota_get_state_partition() (called by /api/selftest and by the
# rollback confirmation), esp_image_verify() at the end of an OTA, and anything
# else that goes through esp_partition_mmap() all do that.
#
# LCD_RGB_ISR_IRAM_SAFE and GDMA_ISR_IRAM_SAFE therefore stay OFF. With them on,
# the refill interrupt keeps running through those windows and its memcpy from
# the PSRAM framebuffer faults: "Cache disabled but cached memory region
# accessed", core 0, ~1 boot in 8 on the bench, because the first thing polled
# after the web server starts is /api/selftest. With them off, the interrupt is
# masked for the window (a few tens of microseconds), the DMA underruns, and
# LCD_RGB_RESTART_IN_VSYNC re-syncs at the next frame. One missed refill on a
# rare event, instead of a panic. This is the configuration esp_lcd documents
# for bounce mode; the IRAM-safe variant was a wrong turn recorded here so it is
# not taken again.
#
# Cost: ~58 KB of internal SRAM (two 20-line buffers + the IRAM-safe code),
# leaving ~19.6 KB free at web-server start. That is the tightest margin of the
# configs tried; if internal SRAM gets scarce again, shrink
# bounce_buffer_size_px in main.c (20 lines today, Espressif's example uses 10)
# before giving up anything else — but re-check the glitch on a real panel
# afterwards, because that buffer IS the headroom this fix depends on.
# CONFIG_EXAMPLE_DOUBLE_FB is not set
CONFIG_EXAMPLE_USE_BOUNCE_BUFFER=y
# CONFIG_EXAMPLE_AVOID_TEAR_EFFECT_WITH_SEM is not set
# CONFIG_LCD_RGB_ISR_IRAM_SAFE is not set
# CONFIG_GDMA_ISR_IRAM_SAFE is not set
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# LVGL keeps its 120-line PSRAM draw bands and the cross-core flush worker.
# Direct mode into the panel framebuffers was tried and rejected: the RGB
# driver only flips buffers at the end of a DMA frame while LVGL starts the
# next frame immediately, so every scrolled frame tore.
CONFIG_LV_DISP_DEF_REFR_PERIOD=16

# Large UI-only static arrays live in PSRAM (EXT_RAM_BSS_ATTR). Enabling the
# segment also lets IDF's own components use it: .dram0.bss fell 118 -> 28 KB,
# which is most of what pays for the bounce buffers above.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
