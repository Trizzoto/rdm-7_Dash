          { "id": "avi2", "name": "Analog 2", "kind": "select", "states": ["idle", "pressed"] },
          { "id": "avi3", "name": "Analog 3", "kind": "select", "states": ["idle", "pressed"] },
          { "id": "avi4", "name": "Analog 4", "kind": "select", "states": ["idle", "pressed"] },
