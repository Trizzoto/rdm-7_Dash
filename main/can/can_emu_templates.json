          ] },
          { "can_id": 706, "dlc": 8, "every_ms": 20, "fields": [
            { "bit_start": 0,  "bit_length": 8, "endian": 0, "control": "dpi1", "values": [0, 250] },
            { "bit_start": 32, "bit_length": 8, "endian": 0, "control": "dpi2", "values": [0, 250] }
          ] },
          { "can_id": 708, "dlc": 8, "every_ms": 20, "fields": [
            { "bit_start": 0,  "bit_length": 8, "endian": 0, "control": "dpi3", "values": [0, 250] },
            { "bit_start": 32, "bit_length": 8, "endian": 0, "control": "dpi4", "values": [0, 250] }
          ] },
          { "can_id": 710, "dlc": 5, "every_ms": 100, "data": "10090D0100" }
        ],
        "listen": [
          { "can_id": 720, "channels": [
            { "name": "IO{V}_DPO1", "bit_start": 0,  "bit_length": 8, "endian": 0, "scale": 0.4, "unit": "%" },
            { "name": "IO{V}_DPO2", "bit_start": 32, "bit_length": 8, "endian": 0, "scale": 0.4, "unit": "%" }
          ] },
          { "can_id": 722, "channels": [
            { "name": "IO{V}_DPO3", "bit_start": 0,  "bit_length": 8, "endian": 0, "scale": 0.4, "unit": "%" },
            { "name": "IO{V}_DPO4", "bit_start": 32, "bit_length": 8, "endian": 0, "scale": 0.4, "unit": "%" }
          ] }
        ]
      },
      "labels": {
        "704": "Analog inputs 1-4",
        "706": "Switch inputs 1-2",
        "708": "Switch inputs 3-4",
        "710": "Keep-alive",
        "720": "Outputs 1-2 from the ECU",
        "722": "Outputs 3-4 from the ECU"
      },
      "guide": [
        "In NSP, open the IO 12 Expander and tick Box {V}.",
        "Give each analog or switch input its function in NSP, the same as a wired input.",
        "An analog input with several buttons: hold each button on the dash and click Calibrate for it in NSP.",
        "Outputs the ECU drives show on the dash as channels IO{V}_DPO1 to IO{V}_DPO4 (0-100 %)."
